# VodkinNET: корневой .gitignore как дополнительная защита по всему
# репозиторию (у каждого проекта есть ещё и свой собственный .gitignore
# с более специфичными правилами) — никогда не коммитить реальные
# секреты/развёрнутые значения ни из одного из проектов в этом репо.
__pycache__/
*.pyc
.env
*.env
.env.*
*.local.sh
secrets/
*.db
hub.db
*.pem
*.key
secret-path.txt
hub-login.txt
*-client.json
