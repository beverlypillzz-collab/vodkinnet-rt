#!/bin/sh
# netcraze-remote — агент реверс-туннеля для Keenetic/KNDMS (Entware).
#
# v3: точный порт vodkinnet-owrt-remote (та же схема полей admin_*/ssh_*,
# тот же механизм детекта Xray через /proc, те же метрики RAM/Flash/
# Температура/Нагрузка, отдаваемые в heartbeat — панель Hub ждёт ИМЕННО
# эти имена полей и рендерит для них готовые карточки/метрики без правок).
# Отличается только тем, что обязано отличаться из-за ОС: конфиг —
# обычный shell key="value" файл вместо uci (на KNDMS uci нет), плюс
# Keenetic-специфичные добавки: entware_ok() (функциональная проверка
# Entware, не просто "opkg есть в PATH"), generic-пробы модели/LAN-IP без
# привязки к конкретной сборке, самовосстанавливающийся watchdog.

export PATH="/opt/sbin:/opt/bin:/bin:/sbin:/usr/bin:/usr/sbin:${PATH:-}"

CONF="/opt/etc/netcraze-remote/netcraze-remote.conf"
STATE_DIR="/opt/var/run/netcraze-remote"
PID_HB="$STATE_DIR/heartbeat.pid"
LOG_FILE="/opt/var/log/netcraze-remote.log"

if [ -t 1 ]; then
	C_RED='\033[0;31m'; C_GREEN='\033[0;32m'; C_YELLOW='\033[1;33m'; C_NC='\033[0m'
else
	C_RED=''; C_GREEN=''; C_YELLOW=''; C_NC=''
fi

log()  { printf '%s\n' "$*" >&2; }
ok()   { printf '%b[+]%b %s\n' "$C_GREEN" "$C_NC" "$*"; }
warn() { printf '%b[~]%b %s\n' "$C_YELLOW" "$C_NC" "$*"; }
die()  { printf '%b[!!] ОШИБКА:%b %s\n' "$C_RED" "$C_NC" "$*" >&2; exit 1; }

usage() {
	cat <<'EOF'
Использование:
  netcraze-remote status
  netcraze-remote doctor
  netcraze-remote render-client [--stdout]
  netcraze-remote run                 # foreground, вызывается из init-скрипта
  netcraze-remote start / stop / restart
  netcraze-remote heartbeat
  netcraze-remote heartbeat-loop
  netcraze-remote pull-config         # перетянуть конфиг с Hub по HUB_TOKEN

Настройки лежат в /opt/etc/netcraze-remote/netcraze-remote.conf
EOF
}

# --- Entware: проверяем, что это НЕ просто наличие бинаря, а рабочая ------
# --- инсталляция (см. известный баг KNDMS: "Entware может числиться -------
# --- включённым на диске, но не быть развёрнутым по-настоящему") ---------

entware_ok() {
	[ -x /opt/bin/opkg ] || return 1
	[ -f /opt/etc/opkg.conf ] || return 1
	opkg --version >/dev/null 2>&1 || return 1
	if command -v stat >/dev/null 2>&1; then
		root_dev="$(stat -c %d / 2>/dev/null)"
		opt_dev="$(stat -c %d /opt 2>/dev/null)"
		if [ -n "$root_dev" ] && [ -n "$opt_dev" ] && [ "$root_dev" = "$opt_dev" ]; then
			return 1
		fi
	fi
	return 0
}

require_entware() {
	entware_ok || die "Entware не найден или не работает по-настоящему (opkg/opkg.conf/точка монтирования /opt) — см. netcraze_vpn_setup_summary.md про баг 'disk is unchanged'"
}

# --- конфиг: обычный key="value" файл (на KNDMS нет uci) ------------------

need_conf() {
	[ -f "$CONF" ] || die "конфиг не найден: $CONF (см. $CONF.example)"
}

conf_get() {
	local key="$1" default="$2" val
	need_conf
	val="$(sed -n "s/^${key}=\"\{0,1\}\([^\"]*\)\"\{0,1\}[[:space:]]*\$/\1/p" "$CONF" | tail -n1)"
	if [ -n "$val" ]; then printf '%s' "$val"; else printf '%s' "$default"; fi
}

conf_set() {
	local key="$1" value="$2"
	need_conf
	if grep -q "^${key}=" "$CONF"; then
		sed -i "s#^${key}=.*#${key}=\"${value}\"#" "$CONF"
	else
		printf '%s="%s"\n' "$key" "$value" >> "$CONF"
	fi
}

truthy() {
	case "$1" in 1|yes|true|on|Yes|True|On|YES|TRUE|ON) return 0 ;; *) return 1 ;; esac
}

json_escape() {
	printf '%s' "$1" | tr -d '\r' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

json_string() {
	printf '"%s"' "$(json_escape "$1")"
}

safe_id() {
	printf '%s' "$1" | tr -c 'a-zA-Z0-9_-' '-'
}

safe_num() {
	case "$2" in ''|*[!0-9]*) : ;; *) : ;; esac
	case "$1" in
		''|*[!0-9]*) printf '%s' "${2:-0}" ;;
		*) printf '%s' "$1" ;;
	esac
}

# --- generic-детекты устройства (без привязки к конкретной сборке/модели) --

lan_ip_default() {
	local ip iface
	for iface in $(ip -o -4 addr show 2>/dev/null | awk '{print $2}'); do
		case "$iface" in
			lo|ppp*|wan*|pppoe*|tun*|tap*|docker*|veth*) continue ;;
		esac
		ip="$(ip -4 addr show "$iface" 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -n1)"
		case "$ip" in
			10.*|172.1[6-9].*|172.2[0-9].*|172.3[0-1].*|192.168.*)
				printf '%s' "$ip"
				return 0
				;;
		esac
	done
	ip="$(ip -4 addr show 2>/dev/null | awk '/inet /{print $2}' | grep -v '^127\.' | head -n1 | cut -d/ -f1)"
	[ -n "$ip" ] && printf '%s' "$ip" || printf '127.0.0.1'
}

host_model() {
	if [ -r /proc/sys/kernel/ndm_model_name ]; then
		cat /proc/sys/kernel/ndm_model_name 2>/dev/null && return
	fi
	if command -v ndmc >/dev/null 2>&1; then
		ndmc -c 'show version' 2>/dev/null | sed -n 's/^model:[[:space:]]*//p' | head -n1 && return
	fi
	if [ -r /proc/device-tree/model ]; then
		tr -d '\000' </proc/device-tree/model 2>/dev/null && return
	fi
	if [ -r /proc/cpuinfo ]; then
		sed -n 's/^Hardware[[:space:]]*:[[:space:]]*//p' /proc/cpuinfo | head -n1 | grep -q . && \
			sed -n 's/^Hardware[[:space:]]*:[[:space:]]*//p' /proc/cpuinfo | head -n1 && return
	fi
	printf 'Keenetic/KNDMS router'
}

board_name() {
	if command -v ndmc >/dev/null 2>&1; then
		ndmc -c 'show version' 2>/dev/null | sed -n 's/^hw_id:[[:space:]]*//p' | head -n1 && return
	fi
	printf 'unknown'
}

release_text() {
	if command -v ndmc >/dev/null 2>&1; then
		ndmc -c 'show version' 2>/dev/null | sed -n 's/^title:[[:space:]]*//p' | head -n1 | grep -q . && \
			ndmc -c 'show version' 2>/dev/null | sed -n 's/^title:[[:space:]]*//p' | head -n1 && return
	fi
	if [ -r /proc/version ]; then
		printf 'KNDMS (%s)' "$(cat /proc/version 2>/dev/null | awk '{print $3}')" && return
	fi
	printf 'KNDMS unknown'
}

uptime_seconds() {
	if [ -r /proc/uptime ]; then
		cut -d. -f1 /proc/uptime
		return
	fi
	printf '0'
}

load_text() {
	if [ -r /proc/loadavg ]; then
		awk '{print $1" "$2" "$3}' /proc/loadavg
		return
	fi
	printf '0 0 0'
}

memory_text() {
	if [ -r /proc/meminfo ]; then
		awk '
			/^MemTotal:/ { total=$2 }
			/^MemAvailable:/ { avail=$2 }
			/^MemFree:/ && avail=="" { avail=$2 }
			END {
				if (total == "") total = 0
				if (avail == "") avail = 0
				printf "%s/%s kB", avail, total
			}
		' /proc/meminfo
		return
	fi
	printf '0/0 kB'
}

# VodkinNET: на Entware "flash" — это точка монтирования /opt (сама флешка),
# а не /overlay (это специфика OpenWrt squashfs+overlay, которой на KNDMS
# просто нет структурно).
flash_text() {
	local text
	text="$(
		df -k /opt 2>/dev/null | awk '
			function mb(k) {
				if (k == "" || k == 0) return "0 MB"
				return sprintf("%.1f MB", k / 1024)
			}
			END {
				if (NF >= 5) {
					total=$(NF-4); avail=$(NF-2); pct=$(NF-1)
					printf "%s free / %s (%s used)", mb(avail), mb(total), pct
				}
			}
		'
	)"
	[ -n "$text" ] && printf '%s' "$text" || printf 'unknown'
}

temperature_text() {
	local file raw max
	max=""
	for file in /sys/class/thermal/thermal_zone*/temp /sys/devices/virtual/thermal/thermal_zone*/temp /sys/class/hwmon/hwmon*/temp*_input; do
		[ -r "$file" ] || continue
		raw="$(cat "$file" 2>/dev/null | tr -cd '0-9-')"
		[ -n "$raw" ] || continue
		case "$raw" in -*|'') continue ;; esac
		[ -z "$max" ] && max="$raw"
		[ "$raw" -gt "$max" ] 2>/dev/null && max="$raw"
	done
	if [ -n "$max" ]; then
		awk -v t="$max" 'BEGIN { if (t > 1000) printf "%.1f C", t / 1000; else printf "%s C", t }'
		return
	fi
	printf 'unknown'
}

ps_all() {
	ps w 2>/dev/null || ps 2>/dev/null || true
}

# VodkinNET: на практике оказалось, что на этой прошивке/сборке Entware
# просто НЕТ бинаря nohup вообще (opkg install coreutils-nohup не стоит
# по умолчанию) — "nohup ... &" в таком случае тихо ничего не запускает
# (busybox ash пишет "nohup: not found" в лог и на этом всё, никакой
# ошибки наружу, xray просто никогда не стартовал — именно так и было
# найдено на реальном устройстве). Не полагаемся на внешний бинарь
# вообще — тот же эффект (процесс переживает выход родительского
# скрипта, SIGHUP игнорируется) даёт чистый POSIX trap в сабшелле, без
# зависимости от того, что реально установлено в системе.
bg_run() {
	if command -v nohup >/dev/null 2>&1; then
		nohup "$@" &
	else
		(trap '' HUP; exec "$@") &
	fi
}

ssh_running() {
	ps_all | grep -E '[d]ropbear|[s]shd' >/dev/null 2>&1
}

# --- xray: поиск бинаря, детект запущенности через /proc (не pidfile) -----
# VodkinNET: как и в owrt-remote — matching по /proc/*/cmdline на путь
# конфига надёжнее, чем самоуправляемый pidfile: переживает внешний
# рестарт/ручной запуск и не путается со stale pidfile после краша.

xray_bin_path() {
	local configured candidate
	configured="$(conf_get XRAY_BIN '')"
	if [ -n "$configured" ] && [ -x "$configured" ]; then
		printf '%s' "$configured"
		return 0
	fi
	for candidate in \
		/opt/sbin/xray /opt/bin/xray /opt/usr/bin/xray /opt/usr/sbin/xray \
		/opt/sbin/xray-core /opt/bin/xray-core /opt/usr/bin/xray-core /opt/usr/sbin/xray-core \
		/opt/tmp/xray /opt/tmp/xray-core
	do
		if [ -x "$candidate" ]; then
			printf '%s' "$candidate"
			return 0
		fi
	done
	candidate="$(command -v xray 2>/dev/null || command -v xray-core 2>/dev/null || true)"
	if [ -n "$candidate" ] && [ -x "$candidate" ]; then
		printf '%s' "$candidate"
		return 0
	fi
	return 1
}

ensure_xray_available() {
	if xray_bin_path >/dev/null 2>&1; then
		return 0
	fi
	require_entware
	log "Xray не найден, пробую поставить через opkg (пакет xray-core)..."
	opkg update >/dev/null 2>&1
	opkg install xray-core || die "не удалось поставить xray-core через opkg"
	xray_bin_path >/dev/null 2>&1 || die "xray-core поставлен, но бинарь не найден по известным путям"
}

xray_pids() {
	local config cmdline cmd pid
	config="$(conf_get XRAY_CONFIG /opt/etc/netcraze-remote/xray-client.json)"
	[ -n "$config" ] || return 0
	for cmdline in /proc/[0-9]*/cmdline; do
		[ -r "$cmdline" ] || continue
		cmd="$(tr '\000' ' ' <"$cmdline" 2>/dev/null || true)"
		case "$cmd" in
			*xray*"$config"*|*xray-core*"$config"*)
				pid="${cmdline%/cmdline}"
				pid="${pid##*/}"
				printf '%s\n' "$pid"
				;;
		esac
	done
}

xray_running() {
	[ -n "$(xray_pids)" ]
}

# --- рендер клиентского xray-конфига (та же fixed admin+ssh схема, что --
# --- и в vodkinnet-owrt-remote — Hub ждёт именно эти два reverse-канала) --

render_client_config() {
	local out stdout router_id vps_host vps_port uuid ssh_uuid encryption flow
	local reverse_tag ssh_reverse_tag admin_host admin_port ssh_host ssh_port
	local xray_config tls_sni stream_settings

	stdout="0"
	[ "${1:-}" = "--stdout" ] && stdout="1"

	router_id="$(safe_id "$(conf_get ROUTER_ID netcraze)")"
	vps_host="$(conf_get VPS_HOST '')"
	vps_port="$(safe_num "$(conf_get VPS_PORT 8444)" 8444)"
	uuid="$(conf_get VLESS_UUID '')"
	ssh_uuid="$(conf_get SSH_VLESS_UUID '')"
	encryption="$(conf_get VLESS_ENCRYPTION none)"
	flow="$(conf_get VLESS_FLOW '')"
	reverse_tag="$(safe_id "$(conf_get REVERSE_TAG reverse-in)")"
	ssh_reverse_tag="$(safe_id "$(conf_get SSH_REVERSE_TAG "${reverse_tag}-ssh")")"
	admin_host="$(conf_get ADMIN_HOST "$(lan_ip_default)")"
	admin_port="$(safe_num "$(conf_get ADMIN_PORT 80)" 80)"
	ssh_host="$(conf_get SSH_HOST "$(lan_ip_default)")"
	ssh_port="$(safe_num "$(conf_get SSH_PORT 22)" 22)"
	xray_config="$(conf_get XRAY_CONFIG /opt/etc/netcraze-remote/xray-client.json)"
	tls_sni="$(conf_get TLS_SNI '')"

	[ -n "$vps_host" ] || die "VPS_HOST пустой"
	[ -n "$uuid" ] || die "VLESS_UUID пустой"
	[ -n "$ssh_uuid" ] || ssh_uuid="$uuid"

	if [ -n "$tls_sni" ]; then
		stream_settings="\"streamSettings\": {
        \"network\": \"tcp\",
        \"security\": \"tls\",
        \"tlsSettings\": {
          \"serverName\": \"$(json_escape "$tls_sni")\",
          \"allowInsecure\": false
        }
      }"
	else
		stream_settings="\"streamSettings\": {
        \"network\": \"tcp\",
        \"security\": \"none\"
      }"
		warn "TLS_SNI пустой — реверс-канал идёт БЕЗ шифрования"
	fi

	out="${TMPDIR:-/opt/tmp}/netcraze-remote-client.$$"
	mkdir -p "$(dirname "$out")"
	cat >"$out" <<EOF
{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [],
  "outbounds": [
    {
      "tag": "router-admin",
      "protocol": "freedom",
      "settings": {
        "redirect": "$(json_escape "$admin_host"):$admin_port"
      }
    },
    {
      "tag": "router-ssh",
      "protocol": "freedom",
      "settings": {
        "redirect": "$(json_escape "$ssh_host"):$ssh_port"
      }
    },
    {
      "tag": "vps-interconn",
      "protocol": "vless",
      "settings": {
        "address": "$(json_escape "$vps_host")",
        "port": $vps_port,
        "id": "$(json_escape "$uuid")",
        "encryption": "$(json_escape "$encryption")",
        "flow": "$(json_escape "$flow")",
        "reverse": {
          "tag": "$(json_escape "$reverse_tag")"
        }
      },
      $stream_settings
    },
    {
      "tag": "vps-ssh-interconn",
      "protocol": "vless",
      "settings": {
        "address": "$(json_escape "$vps_host")",
        "port": $vps_port,
        "id": "$(json_escape "$ssh_uuid")",
        "encryption": "$(json_escape "$encryption")",
        "flow": "$(json_escape "$flow")",
        "reverse": {
          "tag": "$(json_escape "$ssh_reverse_tag")"
        }
      },
      $stream_settings
    }
  ],
  "routing": {
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "$(json_escape "$reverse_tag")"
        ],
        "outboundTag": "router-admin"
      },
      {
        "type": "field",
        "inboundTag": [
          "$(json_escape "$ssh_reverse_tag")"
        ],
        "outboundTag": "router-ssh"
      }
    ]
  },
  "remarks": "netcraze-remote client for $(json_escape "$router_id")"
}
EOF

	if [ "$stdout" = "1" ]; then
		cat "$out"
		rm -f "$out"
		return
	fi

	mkdir -p "$(dirname "$xray_config")"
	cp "$out" "$xray_config"
	chmod 0600 "$xray_config"
	rm -f "$out"
	printf '%s\n' "$xray_config"
}

# --- запуск xray в фоне ----------------------------------------------------

start_xray() {
	local enabled xray_bin xray_config
	require_entware
	enabled="$(conf_get ENABLED 0)"
	truthy "$enabled" || die "сервис выключен: поставь ENABLED=\"1\" в $CONF"

	if xray_running; then
		warn "xray уже запущен (pid $(xray_pids | tr '\n' ' '))"
		return 0
	fi

	ensure_xray_available
	xray_bin="$(xray_bin_path)" || die "xray не найден"
	xray_config="$(render_client_config)"

	mkdir -p "$(dirname "$LOG_FILE")"

	if "$xray_bin" help 2>/dev/null | grep -q '^ *run'; then
		bg_run "$xray_bin" run -config "$xray_config" >>"$LOG_FILE" 2>&1
	else
		bg_run "$xray_bin" -config "$xray_config" >>"$LOG_FILE" 2>&1
	fi
	sleep 1
	if xray_running; then
		ok "xray запущен (pid $(xray_pids | tr '\n' ' ')), конфиг $xray_config"
	else
		warn "xray стартовал, но не виден в /proc через секунду — проверь $LOG_FILE"
	fi
}

stop_xray() {
	local pids pid alive
	pids="$(xray_pids)"
	if [ -z "$pids" ]; then
		warn "xray не был запущен"
		return 0
	fi
	for pid in $pids; do
		kill "$pid" >/dev/null 2>&1 || true
	done
	sleep 1
	alive=""
	for pid in $pids; do
		if kill -0 "$pid" >/dev/null 2>&1; then
			kill -9 "$pid" >/dev/null 2>&1 || true
			alive="$alive $pid"
		fi
	done
	if [ -n "$alive" ]; then
		ok "xray остановлен принудительно:$alive"
	else
		ok "xray остановлен"
	fi
}

heartbeat_running() {
	[ -f "$PID_HB" ] || return 1
	kill -0 "$(cat "$PID_HB" 2>/dev/null)" 2>/dev/null
}

# --- heartbeat: те же имена полей, что и у owrt-remote --------------------
# (release/board/model/admin_host/admin_port/ssh_host/ssh_port/uptime/load/
# memory/flash/temperature/xray/ssh/service) — Hub рендерит карточки под
# них без каких-либо правок на своей стороне.

heartbeat_json() {
	local router_id router_name role public_url hub_url xray_state ssh_state enabled_state

	router_id="$(safe_id "$(conf_get ROUTER_ID netcraze)")"
	router_name="$(conf_get ROUTER_NAME "$router_id")"
	role="$(conf_get ROLE node)"
	public_url="$(conf_get PUBLIC_URL '')"
	hub_url="$(conf_get HUB_URL '')"

	xray_running && xray_state="running" || xray_state="stopped"
	ssh_running && ssh_state="running" || ssh_state="stopped"
	truthy "$(conf_get ENABLED 0)" && enabled_state="enabled" || enabled_state="disabled"

	cat <<EOF
{
  "id": $(json_string "$router_id"),
  "name": $(json_string "$router_name"),
  "role": $(json_string "$role"),
  "model": $(json_string "$(host_model)"),
  "board": $(json_string "$(board_name)"),
  "release": $(json_string "$(release_text)"),
  "hostname": $(json_string "$(hostname 2>/dev/null || printf keenetic)"),
  "public_url": $(json_string "$public_url"),
  "admin_host": $(json_string "$(conf_get ADMIN_HOST "$(lan_ip_default)")"),
  "admin_port": $(safe_num "$(conf_get ADMIN_PORT 80)" 80),
  "ssh_host": $(json_string "$(conf_get SSH_HOST "$(lan_ip_default)")"),
  "ssh_port": $(safe_num "$(conf_get SSH_PORT 22)" 22),
  "hub_url": $(json_string "$hub_url"),
  "uptime": $(safe_num "$(uptime_seconds)" 0),
  "load": $(json_string "$(load_text)"),
  "memory": $(json_string "$(memory_text)"),
  "flash": $(json_string "$(flash_text)"),
  "temperature": $(json_string "$(temperature_text)"),
  "xray": $(json_string "$xray_state"),
  "ssh": $(json_string "$ssh_state"),
  "service": $(json_string "$enabled_state")
}
EOF
}

post_json() {
	local url="$1" token="$2" file="$3"
	if command -v curl >/dev/null 2>&1; then
		curl -fsS -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
			--data-binary "@$file" "$url"
		return
	fi
	if command -v wget >/dev/null 2>&1; then
		wget -q -O - --header="Authorization: Bearer $token" --header="Content-Type: application/json" \
			--post-file="$file" "$url"
		return
	fi
	die "нужен curl или wget для heartbeat (opkg install curl)"
}

send_heartbeat() {
	local hub_url token endpoint tmp
	hub_url="$(conf_get HUB_URL '')"
	token="$(conf_get HUB_TOKEN '')"
	[ -n "$hub_url" ] || die "HUB_URL пустой"
	[ -n "$token" ] || die "HUB_TOKEN пустой"
	endpoint="${hub_url%/}/api/heartbeat"
	tmp="${TMPDIR:-/opt/tmp}/netcraze-remote-hb.$$"
	mkdir -p "$(dirname "$tmp")"
	heartbeat_json > "$tmp"
	post_json "$endpoint" "$token" "$tmp"
	rm -f "$tmp"
}

heartbeat_loop() {
	local interval enabled
	interval="$(conf_get HEARTBEAT_INTERVAL 30)"
	case "$interval" in ''|*[!0-9]*) interval=30 ;; esac
	[ "$interval" -lt 10 ] && interval=10
	mkdir -p "$STATE_DIR"
	echo $$ > "$PID_HB"
	while :; do
		send_heartbeat >/dev/null 2>&1 || true
		# VodkinNET: самовосстановление — если xray упал, зайти его
		# перезапустить вручную физически некуда (тоннель и есть канал
		# доступа), поэтому чиним сами.
		enabled="$(conf_get ENABLED 0)"
		if truthy "$enabled" && entware_ok && ! xray_running; then
			log "watchdog: xray не запущен, пробую поднять..."
			start_xray >/dev/null 2>&1 || log "watchdog: не удалось поднять xray"
		fi
		sleep "$interval"
	done
}

start_heartbeat() {
	if heartbeat_running; then
		warn "heartbeat уже запущен (pid $(cat "$PID_HB"))"
		return 0
	fi
	mkdir -p "$STATE_DIR" "$(dirname "$LOG_FILE")"
	bg_run "$0" heartbeat-loop >>"$LOG_FILE" 2>&1
	echo $! > "$PID_HB"
	ok "heartbeat запущен, pid $(cat "$PID_HB")"
}

stop_heartbeat() {
	if heartbeat_running; then
		kill "$(cat "$PID_HB")" 2>/dev/null
		rm -f "$PID_HB"
		ok "heartbeat остановлен"
	else
		warn "heartbeat не был запущен"
	fi
}

# --- pull-config: перетянуть конфиг с Hub целиком (text/plain) -----------

pull_config() {
	local hub_url token endpoint tmp enabled xray_bin xray_config hb_interval
	hub_url="$(conf_get HUB_URL '')"
	token="$(conf_get HUB_TOKEN '')"
	[ -n "$hub_url" ] || die "HUB_URL пустой"
	[ -n "$token" ] || die "HUB_TOKEN пустой"
	endpoint="${hub_url%/}/router/$(conf_get ROUTER_ID netcraze)/config"
	tmp="${TMPDIR:-/opt/tmp}/netcraze-remote-pull.$$"
	mkdir -p "$(dirname "$tmp")"

	if command -v curl >/dev/null 2>&1; then
		curl -fsS -H "Authorization: Bearer $token" "$endpoint" -o "$tmp" || die "не смог скачать конфиг с Hub"
	else
		wget -q -O "$tmp" --header="Authorization: Bearer $token" "$endpoint" || die "не смог скачать конфиг с Hub"
	fi
	grep -q '^ROUTER_ID=' "$tmp" || die "ответ Hub не похож на валидный конфиг (проверь HUB_TOKEN/HUB_URL)"

	enabled="$(conf_get ENABLED 1)"
	xray_bin="$(conf_get XRAY_BIN '')"
	xray_config="$(conf_get XRAY_CONFIG /opt/etc/netcraze-remote/xray-client.json)"
	hb_interval="$(conf_get HEARTBEAT_INTERVAL 30)"

	cp "$CONF" "${CONF}.bak.$(date +%s 2>/dev/null || echo old)" 2>/dev/null || true
	cp "$tmp" "$CONF"
	rm -f "$tmp"
	chmod 600 "$CONF"

	conf_set ENABLED "$enabled"
	[ -n "$xray_bin" ] && conf_set XRAY_BIN "$xray_bin"
	conf_set XRAY_CONFIG "$xray_config"
	conf_set HEARTBEAT_INTERVAL "$hb_interval"

	ok "конфиг обновлён из Hub (бэкап рядом с .bak.*), перезапусти: netcraze-remote restart"
}

# --- status / doctor -------------------------------------------------------

status() {
	printf 'router_id: %s\n' "$(conf_get ROUTER_ID '')"
	printf 'router_name: %s\n' "$(conf_get ROUTER_NAME '')"
	printf 'role: %s\n' "$(conf_get ROLE node)"
	printf 'enabled: %s\n' "$(conf_get ENABLED 0)"
	printf 'hub_url: %s\n' "$(conf_get HUB_URL '')"
	printf 'vps_host: %s\n' "$(conf_get VPS_HOST '')"
	printf 'vps_port: %s\n' "$(conf_get VPS_PORT 8444)"
	printf 'admin: %s:%s\n' "$(conf_get ADMIN_HOST "$(lan_ip_default)")" "$(conf_get ADMIN_PORT 80)"
	printf 'ssh: %s:%s\n' "$(conf_get SSH_HOST "$(lan_ip_default)")" "$(conf_get SSH_PORT 22)"
	printf 'xray_bin: %s\n' "$(xray_bin_path 2>/dev/null || echo 'не найден')"
	printf 'xray_config: %s\n' "$(conf_get XRAY_CONFIG /opt/etc/netcraze-remote/xray-client.json)"
	if xray_running; then printf 'xray_state: running (pid %s)\n' "$(xray_pids | tr '\n' ' ')"; else printf 'xray_state: stopped\n'; fi
	if heartbeat_running; then printf 'heartbeat_state: running (pid %s)\n' "$(cat "$PID_HB")"; else printf 'heartbeat_state: stopped\n'; fi
	entware_ok && printf 'entware: ok\n' || printf 'entware: НЕ РАБОТАЕТ (см. doctor)\n'
}

doctor() {
	local ok_all=1

	printf 'Диагностика netcraze-remote\n'
	printf -- '---------------------------\n'

	if entware_ok; then
		ok "Entware работает по-настоящему (opkg/opkg.conf/отдельная точка монтирования /opt)"
	else
		printf '%b[!!]%b Entware НЕ прошёл функциональную проверку\n' "$C_RED" "$C_NC"
		ok_all=0
	fi

	if [ -f "$CONF" ]; then ok "конфиг найден: $CONF"; else
		printf '%b[!!]%b конфиг не найден: %s\n' "$C_RED" "$C_NC" "$CONF"
		ok_all=0
	fi

	if xray_bin_path >/dev/null 2>&1; then
		ok "xray бинарь: $(xray_bin_path)"
	else
		printf '%b[!!]%b xray-core не найден (opkg install xray-core)\n' "$C_RED" "$C_NC"
		ok_all=0
	fi

	for key in VPS_HOST VLESS_UUID HUB_URL HUB_TOKEN; do
		val="$(conf_get "$key" '')"
		if [ -n "$val" ]; then ok "$key задан"; else
			printf '%b[!!]%b %s пустой в конфиге\n' "$C_RED" "$C_NC" "$key"
			ok_all=0
		fi
	done

	if xray_running; then ok "xray процесс запущен ($(xray_pids | tr '\n' ' '))"; else warn "xray процесс не запущен (netcraze-remote start)"; fi
	if heartbeat_running; then ok "heartbeat запущен"; else warn "heartbeat не запущен"; fi

	if [ -d /opt/etc/xray/configs ]; then
		warn "обнаружен /opt/etc/xray/configs (похоже на XKeen) — netcraze-remote его НЕ трогает, использует отдельный XRAY_CONFIG=$(conf_get XRAY_CONFIG /opt/etc/netcraze-remote/xray-client.json)"
	fi

	# Живая проверка: реально ли запускается xray с текущим конфигом
	# (полезно поймать ошибку JSON/бинаря ДО попытки полноценного старта)
	if xray_bin_path >/dev/null 2>&1 && [ -n "$(conf_get VLESS_UUID '')" ]; then
		local test_config test_bin test_out test_rc
		test_bin="$(xray_bin_path)"
		test_config="$(render_client_config --stdout 2>/dev/null | tee "${TMPDIR:-/opt/tmp}/ncr-doctor-test.json" 2>/dev/null)"
		if command -v python3 >/dev/null 2>&1; then
			if printf '%s' "$test_config" | python3 -c "import json,sys; json.load(sys.stdin)" >/dev/null 2>&1; then
				ok "сгенерированный client-конфиг — валидный JSON"
			else
				printf '%b[!!]%b сгенерированный client-конфиг НЕ валидный JSON — вот он:\n' "$C_RED" "$C_NC"
				printf '%s\n' "$test_config"
				ok_all=0
			fi
		fi
		# VodkinNET: проверяем КОД ВОЗВРАТА, а не текст вывода — xray сам
		# пишет служебные строки вида "common/errors: ..." даже для
		# обычных warning'ов (это имя внутреннего Go-пакета, не признак
		# сбоя), и грубый grep по слову "error" ложно матчил такие строки
		# при полностью успешной проверке ("Configuration OK."). Найдено
		# на реальном устройстве — Xray принял конфиг, но doctor всё
		# равно рапортовал о проблеме.
		test_out="$("$test_bin" -test -config "${TMPDIR:-/opt/tmp}/ncr-doctor-test.json" 2>&1)"
		test_rc=$?
		if [ "$test_rc" -ne 0 ]; then
			test_out="$("$test_bin" run -test -config "${TMPDIR:-/opt/tmp}/ncr-doctor-test.json" 2>&1)"
			test_rc=$?
		fi
		if [ "$test_rc" -eq 0 ]; then
			ok "xray принял тестовый конфиг (-test) без ошибок"
		else
			printf '%b[!!]%b xray не принял конфиг (тестовый прогон, код возврата %s):\n%s\n' "$C_RED" "$C_NC" "$test_rc" "$test_out"
			ok_all=0
		fi
		rm -f "${TMPDIR:-/opt/tmp}/ncr-doctor-test.json"
	fi

	[ "$ok_all" = "1" ] && ok "всё выглядит нормально" || warn "есть проблемы — см. выше"
}

# --- main -------------------------------------------------------------------

cmd="${1:-}"
[ -n "$cmd" ] && shift
case "$cmd" in
	status) status ;;
	doctor) doctor ;;
	render-client) render_client_config "$@" ;;
	run) render_client_config >/dev/null; start_xray; start_heartbeat ;;
	start) start_xray; start_heartbeat ;;
	stop) stop_xray; stop_heartbeat ;;
	restart) stop_xray; stop_heartbeat; sleep 1; start_xray; start_heartbeat ;;
	heartbeat) send_heartbeat ;;
	heartbeat-loop) heartbeat_loop ;;
	pull-config) pull_config ;;
	*) usage; [ -n "$cmd" ] && exit 1 || exit 0 ;;
esac
