[Unit]
Description=NDMS-remote Xray (reverse tunnel portal for Keenetic fleet)
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/NDMS-remote-xray run -config /etc/NDMS-remote/xray.json
Restart=on-failure
RestartSec=3
# VodkinNET: не root — читает сертификат через членство в группе ssl-cert
# (стандартный для этого сервера паттерн, как и у соседних панелей).
User=NDMS-remote
Group=NDMS-remote
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
