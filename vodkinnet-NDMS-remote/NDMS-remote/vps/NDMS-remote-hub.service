[Unit]
Description=NDMS-remote Hub (Keenetic/KNDMS fleet panel)
After=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/NDMS-remote/hub.env
ExecStart=/usr/bin/python3 /opt/NDMS-remote/NDMS-remote-hub.py serve
Restart=on-failure
RestartSec=3
# VodkinNET: НЕ root. Единственное root-действие (рестарт NDMS-remote-xray)
# идёт через узкое sudoers-правило (см. NDMS-remote.sudoers), не через
# полные права самого процесса — это интернет-facing HTTP-сервер.
#
# /run/sudo добавлен в ReadWritePaths — найдено на практике: sudo сам
# пытается писать туда свой файл-"тикет" (кеш успешной аутентификации),
# и ProtectSystem=strict без явного разрешения делает ВЕСЬ /run
# доступным только для чтения, из-за чего sudo падал с "unable to open
# /run/sudo/ts/999: Read-only file system" при попытке рестарта Xray
# через кнопку "Рестарт Xray VPS"/"Обновить Xray CFG" в панели.
User=NDMS-remote
Group=NDMS-remote
WorkingDirectory=/opt/NDMS-remote
ProtectSystem=strict
ReadWritePaths=/var/lib/NDMS-remote /etc/NDMS-remote /run/sudo

[Install]
WantedBy=multi-user.target
