[Unit]
Description=VodkinNET RT Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=OWRT_REMOTE_BIND=0.0.0.0
Environment=OWRT_REMOTE_PORT=8088
# VodkinNET: EXTRA_PORTS=80 убран — конфликтовал с nginx-редиректом
# vodkin.net (лендинг), который тоже слушает 80 на этом сервере. Раньше
# это уже фиксили через drop-in, но сам файл юнита в репозитории не был
# обновлён — при следующем полном redeploy регрессия вернулась бы снова.
Environment=OWRT_REMOTE_STATE_DIR=/var/lib/owrt-remote
Environment=OWRT_REMOTE_SUDO_RESTART=1
ExecStart=/opt/owrt-remote/owrt-remote-run.sh serve
Restart=on-failure
RestartSec=3
# VodkinNET: НЕ root — отдельный системный пользователь openwrt-remote.
# AmbientCapabilities всё ещё даёт право биндиться на порт 80 без root
# (это системная capability, не требует полных прав пользователя).
# Рестарт owrt-remote-xray — через узкое sudoers-правило (см.
# owrt-remote.sudoers), не через полные права самого процесса.
User=openwrt-remote
Group=openwrt-remote
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
DynamicUser=no

[Install]
WantedBy=multi-user.target
