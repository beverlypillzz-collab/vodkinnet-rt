#!/bin/sh
# VodkinNET: owrt-remote-watchdog — ПОЛНОСТЬЮ ОТДЕЛЬНЫЙ файл от
# /usr/sbin/owrt-remote. update_agent() внутри owrt-remote никогда не
# трогает этот файл и не знает о его существовании. Это сознательное
# архитектурное решение: логика "нет коннекта — откатить бэкап" не должна
# зависеть от того, насколько сломан НОВЫЙ агент. Если update поставил
# версию, которая не может даже подняться (синтаксическая ошибка,
# heartbeat-loop падает при старте, что угодно) — само по себе это никак
# не влияет на watchdog, потому что watchdog не читает и не исполняет код
# из owrt-remote вообще, только свои встроенные проверки ниже.
#
# Запускается через cron (не procd-инстанс сервиса owrtremote) — именно
# потому что procd-инстансы принадлежат тому же сервису, что и агент, и
# если сервис не поднимается, поднимать некому. cron — независимый от
# owrtremote системный демон, тикает по расписанию вне зависимости от
# состояния конкретного сервиса.
#
# Установка (один раз, не через update):
#   echo "* * * * * /usr/sbin/owrt-remote-watchdog" >> /etc/crontabs/root
#   /etc/init.d/cron restart

CONFIG="owrtremote"
SECTION="main"
BIN="/usr/sbin/owrt-remote"
BAK="${BIN}.bak"
INITD="/etc/init.d/owrt-remote"
INITD_BAK="${INITD}.bak"
MARKER="/etc/owrt-remote-update-pending"
LOG="/etc/owrt-remote-rollback.log"

# Нет маркера обновления — обновления не было (или уже разобрались),
# watchdog'у делать нечего. Дальше проверять смысла нет.
[ -f "$MARKER" ] || exit 0

uci_get() {
	local v
	v="$(uci -q get "$CONFIG.$SECTION.$1" 2>/dev/null)"
	if [ -n "$v" ]; then
		printf '%s' "$v"
	else
		printf '%s' "$2"
	fi
}

marker_ts="$(cat "$MARKER" 2>/dev/null)"
case "$marker_ts" in
	''|*[!0-9]*)
		# битый маркер — не даём watchdog'у застрять в цикле навсегда
		rm -f "$MARKER"
		exit 0
		;;
esac

now="$(date +%s 2>/dev/null || echo 0)"
elapsed=$((now - marker_ts))

grace="$(uci_get rollback_grace_seconds 30)"
case "$grace" in ''|*[!0-9]*) grace=30 ;; esac

vps_host="$(uci_get vps_host '')"
vps_port="$(uci_get vps_port 8443)"
case "$vps_port" in ''|*[!0-9]*) vps_port=8443 ;; esac

is_ipv4_literal() {
	case "$1" in
		''|*[!0-9.]*) return 1 ;;
	esac
	case "$1" in
		*.*.*.*) return 0 ;;
		*) return 1 ;;
	esac
}

# VodkinNET: намеренно СВОЯ копия логики проверки туннеля, не общая функция
# с owrt-remote. Watchdog не должен зависеть ни от чего внешнего, включая
# код основного агента — если тот битый, это не должно ломать и watchdog.
tunnel_up() {
	[ -n "$vps_host" ] || return 1
	[ -r /proc/net/tcp ] || return 1

	local hex_port a b c d hex_ip pattern found
	hex_port="$(printf '%04X' "$vps_port")"

	if is_ipv4_literal "$vps_host"; then
		IFS=. read -r a b c d <<-EOF_VPSIP
$vps_host
EOF_VPSIP
		hex_ip="$(printf '%02X%02X%02X%02X' "$d" "$c" "$b" "$a")"
		pattern="${hex_ip}:${hex_port}"
		found="$(awk -v p="$pattern" '$4=="01" && $3==p {print "1"; exit}' /proc/net/tcp)"
	else
		pattern=":${hex_port}"
		found="$(awk -v p="$pattern" -v plen="${#pattern}" \
			'$4=="01" { if (substr($3, length($3)-plen+1) == p) { print "1"; exit } }' \
			/proc/net/tcp)"
	fi

	[ "$found" = "1" ]
}

if tunnel_up; then
	# Туннель реально жив — обновление прижилось, снимаем маркер и не лезем.
	rm -f "$MARKER"
	exit 0
fi

[ "$elapsed" -ge "$grace" ] || exit 0

# Grace истёк, туннеля нет. Откатываем — НЕЗАВИСИМО от того, что вообще
# происходит с текущим /usr/sbin/owrt-remote: не исполняем его, не зовём
# его функции, только копируем .bak поверх через безопасный mv.
if [ ! -x "$BAK" ]; then
	logger -t owrt-remote-watchdog "rollback needed but $BAK missing or not executable"
	rm -f "$MARKER"
	exit 1
fi

tmp="${BIN}.watchdog.$$"
if cp "$BAK" "$tmp" 2>/dev/null && chmod +x "$tmp" 2>/dev/null; then
	mv "$tmp" "$BIN"
else
	rm -f "$tmp"
	logger -t owrt-remote-watchdog "rollback failed: could not prepare temp copy from $BAK"
	exit 1
fi

# VodkinNET: install.sh бэкапит и init.d (не только сам агент) — тот же
# файл, что уже один раз молча ронял heartbeat-инстанс при restart. Если
# бэкап init.d есть, откатываем и его — той же независимой, ничего не
# исполняющей из owrt-remote схемой.
if [ -f "$INITD_BAK" ]; then
	tmp_initd="${INITD}.watchdog.$$"
	if cp "$INITD_BAK" "$tmp_initd" 2>/dev/null && chmod +x "$tmp_initd" 2>/dev/null; then
		mv "$tmp_initd" "$INITD"
	else
		rm -f "$tmp_initd"
		logger -t owrt-remote-watchdog "rollback: could not restore init.d from $INITD_BAK (agent still rolled back)"
	fi
fi

rm -f "$MARKER"
printf '%s watchdog: откат выполнен (туннель не поднялся за %sс, прошло %sс)\n' \
	"$(date '+%F %T' 2>/dev/null || echo '?')" "$grace" "$elapsed" >>"$LOG" 2>/dev/null
logger -t owrt-remote-watchdog "rollback executed: tunnel down after ${elapsed}s (grace ${grace}s), restored $BAK"

# service restart — не exec, чтобы cron-джоба сама корректно завершилась
/etc/init.d/owrt-remote restart >/dev/null 2>&1 &
