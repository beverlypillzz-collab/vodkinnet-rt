#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

uci_get() {
	local key default value
	key="$1"
	default="$2"
	value="$(uci -q get "owrtremote.main.$key" 2>/dev/null || true)"
	[ -n "$value" ] && {
		printf '%s' "$value"
		return
	}
	printf '%s' "$default"
}

config_enabled() {
	case "$(uci_get enabled 0)" in
		1|yes|true|on|enabled) return 0 ;;
		*) return 1 ;;
	esac
}

start_service() {
	mkdir -p /var/lock /var/run /tmp/owrt-xray

	if ! config_enabled; then
		echo "owrt-remote disabled in /etc/config/owrtremote"
		return 0
	fi

	procd_open_instance xray
	procd_set_param command /usr/sbin/owrt-remote run
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance heartbeat
	procd_set_param command /usr/sbin/owrt-remote heartbeat-loop
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

# VodkinNET: НЕ переопределяем stop_service() под USE_PROCD=1.
# procd_open_instance() в start_service() регистрирует ОБА инстанса (xray,
# heartbeat) и procd сам знает точный PID каждого форкнутого им процесса —
# штатный stop() из /etc/rc.common корректно останавливает оба.
# Баг, найденный вживую на канарейке: кастомный stop_service() (удалён
# отсюда вместе с dead-code хелперами stop_xray_processes/xray_pids,
# которые он один и вызывал) останавливал ТОЛЬКО xray через ручной скан
# /proc/*/cmdline. Из-за этого при каждом
# `/etc/init.d/owrt-remote restart` procd видел, что heartbeat-инстанс
# "как бы всё ещё жив" (сам он его не останавливал) и не перезапускал —
# новый код в /usr/sbin/owrt-remote (в т.ч. self_heal_check в
# heartbeat_loop) при этом на диске уже стоял, но никогда не подхватывался
# в память работающего процесса. Итог: rollback-логика физически не
# исполнялась после `update`, хотя маркер и .bak создавались верно.

service_triggers() {
	procd_add_reload_trigger owrtremote
}
